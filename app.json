{
  "expo": {
    "name": "Vigil Social",
    "slug": "amerika-social-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "amerikasocial",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-secure-store",
      [
        "expo-iap",
        {
          "android": {
            "store": "google"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos or videos to share on Vigil Social.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Optionally verify your US location or show approximate Dating distance. Location is never used in the background.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Save branded Vigil Social post images to your photo library.",
          "photosPermission": "Choose media for your posts and Dating profile.",
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": []
        }
      ],
      "expo-notifications",
      "./plugins/withReleaseSigning.js"
    ],
    "android": {
      "package": "social.amerika.android",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#d6004a"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false
    },
    "splash": {
      "image": "./assets/splash/splash-light.png",
      "resizeMode": "contain",
      "imageWidth": 200,
      "backgroundColor": "#f6f1f4",
      "dark": {
        "image": "./assets/splash/splash-dark.png",
        "backgroundColor": "#120a14"
      }
    }
  }
}
